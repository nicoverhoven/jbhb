{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": null,
  "functions": {
    "server.ts": {
      "maxDuration": 60,
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
